# Text is stored and checked out with LF on every operating system.
* text=auto eol=lf

*.go    text eol=lf diff=golang
*.md    text eol=lf diff=markdown
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.mod   text eol=lf
*.sum   text eol=lf
*.sh    text eol=lf
*.svg   text eol=lf

# Binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.webp  binary
*.zip   binary
*.mcpb  binary
*.exe   binary
